# .htaccess - La Granja Don Silvio | lagranjadonsilvio.com
# Migración de WordPress a HTML/CSS - Gestión SEO técnica profesional
# Última actualización: 2026-09-27

# ============================================================================
# 1. REESCRITURA DE MÓDULO - Habilitar mod_rewrite
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
</IfModule>

# ============================================================================
# 2. FORÇA HTTPS (SSL/TLS)
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================================================
# 3. REDIRECCIÓN www ↔ non-www (CANONICAL - Evitar contenido duplicado)
# Opción: Redirigir a NON-www (sin www)
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_HOST} ^www\.lagranjadonsilvio\.com$ [NC]
  RewriteRule ^(.*)$ https://lagranjadonsilvio.com/$1 [L,R=301]
</IfModule>

# ============================================================================
# 4. REDIRECCIONES 301 - RUTAS ANTIGUAS DE WORDPRESS
# Preservar SEO authority de enlaces históricos
# ============================================================================
<IfModule mod_rewrite.c>
  # Redireccionar /wp-admin y /wp-login a inicio
  RewriteCond %{REQUEST_URI} ^/wp-admin [OR]
  RewriteCond %{REQUEST_URI} ^/wp-login [OR]
  RewriteCond %{REQUEST_URI} ^/wp-json [OR]
  RewriteCond %{REQUEST_URI} ^/wp-content [OR]
  RewriteCond %{REQUEST_URI} ^/wp-includes
  RewriteRule ^(.*)$ https://lagranjadonsilvio.com/ [L,R=301]

  # Redireccionar índex.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^index\.php(.*)$ https://lagranjadonsilvio.com/ [L,R=301]

  # Redireccionar /blog/* (antiguo blog WordPress) al inicio
  RewriteRule ^blog/(.*)$ https://lagranjadonsilvio.com/ [L,R=301]

  # Redireccionar /author/* (antiguo archivo de autor)
  RewriteRule ^author/(.*)$ https://lagranjadonsilvio.com/ [L,R=301]

  # Redireccionar /category/* (antiguo archivo de categoría)
  RewriteRule ^category/(.*)$ https://lagranjadonsilvio.com/ [L,R=301]

  # Redireccionar /tag/* (antiguo archivo de etiqueta)
  RewriteRule ^tag/(.*)$ https://lagranjadonsilvio.com/ [L,R=301]

  # Redireccionar /search/* (antiguo búsqueda)
  RewriteRule ^search/(.*)$ https://lagranjadonsilvio.com/ [L,R=301]

  # Redireccionar /feed/* (antiguo RSS)
  RewriteRule ^feed/(.*)$ https://lagranjadonsilvio.com/sitemap.xml [L,R=301]

  # Redireccionar /sitemap.xml (antiguo)
  RewriteRule ^sitemap\.xml$ https://lagranjadonsilvio.com/sitemap.xml [L]

  # Redireccionar /robots.txt (antiguo)
  RewriteRule ^robots\.txt$ https://lagranjadonsilvio.com/robots.txt [L]
</IfModule>

# ============================================================================
# 5. TRAILING SLASHES - Normalización de URLs
# Eliminar trailing slashes (excepto directorios)
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} /$
  RewriteRule ^(.+)/$ https://lagranjadonsilvio.com/$1 [L,R=301]
</IfModule>

# ============================================================================
# 6. BLOQUEAR ACCESO A ARCHIVOS SENSIBLES
# ============================================================================
<FilesMatch "^\.(htaccess|htpasswd|env|git|gitignore)$">
  Order allow,deny
  Deny from all
</FilesMatch>

<FilesMatch "^(wp-config|wp-settings|wp-load|wp-blog-header)\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Bloquear archivos de backup comunes
<FilesMatch "\.(bak|backup|sql|zip|tar|rar|7z|old|orig)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ============================================================================
# 7. COMPRESIÓN GZIP - Optimización de velocidad (Core Web Vitals)
# ============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/xhtml+xml application/xml application/rss+xml
</IfModule>

# ============================================================================
# 8. CACHÉ DEL NAVEGADOR - Configuración de caché para recursos estáticos
# ============================================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Imágenes
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # CSS y JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Fuentes
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # Archivos HTML (baja caché para actualizaciones frecuentes)
  ExpiresByType text/html "access plus 1 week"

  # XML y JSON
  ExpiresByType application/xml "access plus 1 month"
  ExpiresByType application/json "access plus 1 month"
</IfModule>

# ============================================================================
# 9. HEADERS DE SEGURIDAD Y SEO
# ============================================================================
<IfModule mod_headers.c>
  # Evitar clickjacking (X-Frame-Options)
  Header set X-Frame-Options "SAMEORIGIN"

  # Prevenir MIME sniffing
  Header set X-Content-Type-Options "nosniff"

  # Habilitar XSS protection en navegadores antiguos
  Header set X-XSS-Protection "1; mode=block"

  # Content Security Policy - Fortalecer seguridad
  Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: https:; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; connect-src 'self' https:;"

  # Referrer Policy - Control de información en backlinks
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy (Permisos de características del navegador)
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

  # Permitir CORS para fuentes (Google Fonts, FontAwesome)
  Header set Access-Control-Allow-Origin "*"
</IfModule>

# ============================================================================
# 10. MANEJO DE ERRORES 404 PERSONALIZADO
# ============================================================================
ErrorDocument 404 /404.html

# Las URLs inexistentes deben conservar respuesta HTTP 404 y mostrar 404.html.
# No redirigir rutas desconocidas a la Home: evita soft-404 y pérdida de señales SEO.

# ============================================================================
# 11. CANONICAL TAG IMPLÍCITO
# ============================================================================
# El canonical se define en el HTML: <link rel="canonical" href="...">
# Este .htaccess refuerza evitando duplicados mediante redirecciones 301

# No bloquear User-Agents por nombre: el control de rastreo se gestiona en robots.txt.
# Esto evita respuestas 403 a herramientas de auditoría y agentes declarados como permitidos.

# ============================================================================
# 13. DIRECTORIO /img - Permitir acceso a imágenes
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# ============================================================================
# NOTAS DE MANTENIMIENTO SEO
# ============================================================================
# 1. El .htaccess implementa redirecciones 301 que preservan SEO authority
# 2. Force HTTPS en todos los accesos (requisito de Google)
# 3. Normalización de www/non-www para evitar contenido duplicado
# 4. Bloqueo de acceso a archivos WordPress legacy (seguridad)
# 5. Compresión GZIP para mejorar Core Web Vitals (LCP, FID, CLS)
# 6. Caché optimizado según tipo de contenido
# 7. Headers de seguridad implementados (HSTS recomendado en nginx)
# 8. Manejo 404 canaliza tráfico a la página principal
# 9. Bloqueo de bots maliciosos para reducir crawl waste
# 10. Trailing slashes normalizados para evitar duplicación de contenido

# ============================================================================
# COMANDOS PARA ACTIVAR EN SERVIDOR
# ============================================================================
# 1. Verificar que mod_rewrite está habilitado:
#    a2enmod rewrite (Linux/Apache)
#
# 2. Verificar que .htaccess está permitido en VirtualHost:
#    <Directory /var/www/lagranjadonsilvio.com>
#      AllowOverride All
#    </Directory>
#
# 3. Recargar Apache:
#    systemctl reload apache2 (Linux)
#    net stop Apache2.4 && net start Apache2.4 (Windows)
#
# 4. Pruebas de redirecciones:
#    curl -I https://www.lagranjadonsilvio.com (verificar 301 a non-www)
#    curl -I http://lagranjadonsilvio.com (verificar HTTP → HTTPS 301)
#    curl -I https://lagranjadonsilvio.com/wp-admin (verificar bloqueo 301)
